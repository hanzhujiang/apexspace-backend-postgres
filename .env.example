# ─── MySQL ────────────────────────────────────────────────────────────────────
# For local dev: spin up MySQL with `docker compose up -d`
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=apexspace_crm
MYSQL_USER=apexspace
MYSQL_PASSWORD=apexspace_dev

# App environment (development | staging | production)
NODE_ENV=

# Port (default 8888)
PORT=

# JWT signing secret
JWT_SECRET=

# Base URL for publicly served files
PUBLIC_SERVER_FILE=

# DigitalOcean Spaces (file storage)
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_NAME=
DO_SPACES_URL=
REGION=

# AI integrations
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Email (Resend)
RESEND_API=
